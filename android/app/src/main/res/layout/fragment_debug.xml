<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/pane"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/paneTest" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Link test"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/paneLog" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Log"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <FrameLayout android:id="@+id/debugContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
