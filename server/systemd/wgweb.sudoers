# wg-web may run only these exact commands as root
Cmnd_Alias WGWEB = /usr/local/sbin/wg-peer list, \
                   /usr/local/sbin/wg-peer add *, \
                   /usr/local/sbin/wg-peer remove *, \
                   /usr/local/sbin/wg-peer show *, \
                   /usr/local/sbin/wg-peer setmode *, \
                   /usr/local/sbin/wg-admin status, \
                   /usr/local/sbin/wg-admin config, \
                   /usr/local/sbin/wg-admin service *, \
                   /usr/local/sbin/wg-admin levels-set *, \
                   /usr/local/sbin/wg-admin forward *, \
                   /usr/local/sbin/wg-admin logs *
wgweb ALL=(root) NOPASSWD: WGWEB
Defaults:wgweb !requiretty
