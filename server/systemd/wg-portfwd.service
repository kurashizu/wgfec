[Unit]
Description=Port forwards to WireGuard devices (nftables table "ip portfwd", managed by wg-admin)
After=network-online.target wg-u2r-fw.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/wg-portfwd.nft
ExecStop=-/usr/sbin/nft delete table ip portfwd

[Install]
WantedBy=multi-user.target
