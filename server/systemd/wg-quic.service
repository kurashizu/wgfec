[Unit]
Description=wg-quic: lets devices send the FEC tunnel to this server dressed up as QUIC (relay to the UDPspeeder instances)
After=network.target wg-speeder.service

[Service]
DynamicUser=yes
EnvironmentFile=/etc/wg-quic/relay.env
ExecStart=/usr/bin/python3 -I /opt/wg-quic/quic_relay.py --bind 0.0.0.0 --port ${QUIC_PORT} --allow ${QUIC_ALLOW}
Restart=on-failure
RestartSec=3
# Every tunnel packet of a device that uses the disguise goes through this process, so give it room, but not the whole host.
MemoryMax=96M
CPUQuota=70%
# only to bind a port below 1024 (443)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
LockPersonality=yes

[Install]
WantedBy=multi-user.target
